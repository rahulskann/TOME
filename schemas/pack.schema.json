{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOME pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "maps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string"
    },
    "game": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "wiki": {
      "type": "string",
      "format": "uri"
    },
    "categoryGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "group": {
            "type": "string",
            "description": "id of a categoryGroups entry"
          },
          "icon": {
            "enum": [
              "circle",
              "star",
              "heart",
              "chest",
              "key",
              "gem",
              "coin",
              "shield",
              "book",
              "scroll",
              "flag",
              "door",
              "bench",
              "bell",
              "boss",
              "enemy",
              "npc",
              "shop",
              "quest",
              "secret",
              "puzzle",
              "travel",
              "save",
              "tool",
              "skill",
              "upgrade",
              "map",
              "music",
              "flower",
              "fish",
              "bug",
              "water",
              "note"
            ]
          },
          "wiki": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "license": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "image",
          "tileSize",
          "minZoom",
          "maxZoom",
          "tiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "tileSize": {
            "type": "integer",
            "enum": [
              256,
              512
            ]
          },
          "minZoom": {
            "type": "integer",
            "minimum": 0
          },
          "maxZoom": {
            "type": "integer",
            "minimum": 0
          },
          "tiles": {
            "type": "object",
            "required": [
              "archive",
              "path"
            ],
            "properties": {
              "archive": {
                "type": "string"
              },
              "archiveBytes": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string"
              }
            }
          },
          "markers": {
            "type": "string"
          },
          "initialView": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "zoom": {
                "type": "number"
              }
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "map": {
                  "type": "string"
                },
                "outline": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "target": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    }
                  }
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "wiki": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "license": {
                      "type": "string"
                    }
                  }
                }
              },
              "anyOf": [
                {
                  "required": [
                    "outline"
                  ]
                },
                {
                  "required": [
                    "x",
                    "y"
                  ]
                }
              ],
              "dependentRequired": {
                "map": [
                  "outline"
                ]
              }
            }
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "license": {
                "type": "string"
              }
            }
          },
          "wiki": {
            "type": "string"
          }
        }
      }
    }
  }
}
