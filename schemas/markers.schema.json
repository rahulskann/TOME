{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOME markers file",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "x",
      "y"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "name": {
        "type": "string"
      },
      "category": {
        "type": "string"
      },
      "x": {
        "type": "number",
        "minimum": 0
      },
      "y": {
        "type": "number",
        "minimum": 0
      },
      "description": {
        "type": "string"
      },
      "trackable": {
        "type": "boolean",
        "default": true
      },
      "wiki": {
        "type": "string"
      },
      "links": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "map": {
        "type": "string"
      },
      "source": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string"
          }
        }
      }
    }
  }
}
